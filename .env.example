# Copy to .env.local. ONLY public values belong here.
# Anything prefixed with VITE_ is inlined into the browser bundle.
VITE_CONVEX_URL=

# ---------------------------------------------------------------------------
# SECRETS DO NOT GO IN THIS FILE OR ANY .env FILE.
# They live in Convex environment variables, set from your own terminal:
#
#   npx convex env set OPENAI_API_KEY        sk-...
#   npx convex env set OPENAI_REALTIME_MODEL gpt-realtime
#   npx convex env set CONTEXT_DEV_API_KEY   ctxt_secret_...
#
# Verify names (not values) with: npx convex env list
# ---------------------------------------------------------------------------
