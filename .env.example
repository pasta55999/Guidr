# Copy to .env.local. ONLY public values belong here.
# Anything prefixed with VITE_ is inlined into the browser bundle.
# `npx convex dev` writes VITE_CONVEX_URL and VITE_CONVEX_SITE_URL for you.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# ---------------------------------------------------------------------------
# SECRETS DO NOT GO IN THIS FILE OR ANY .env FILE.
# They live in Convex environment variables, set from your own terminal:
#
#   npx convex env set ANTHROPIC_API_KEY   sk-or-v1-...   # an OpenRouter key (see convex/tutor.ts)
#   npx convex env set MUNSIT_API_KEY      <munsit key>
#   npx convex env set CONTEXT_DEV_API_KEY ctxt_secret_...
#
# Optional tuning:
#   npx convex env set ANTHROPIC_MODEL   anthropic/claude-haiku-4.5   # OpenRouter model id
#   npx convex env set MUNSIT_STT_MODEL  munsit-en-ar
#   npx convex env set MUNSIT_VOICE_ID   ar-najdi-male-2
#   npx convex env set MUNSIT_DIALECT    emirati
#
# Verify names (not values) with: npx convex env list
# ---------------------------------------------------------------------------
